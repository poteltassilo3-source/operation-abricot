{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "operation-abricot",
  "main": "worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/ws"]
  },
  "durable_objects": {
    "bindings": [{ "name": "SALLES", "class_name": "Salle" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Salle"] }]
}
